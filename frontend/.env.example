# ========================================================
# ACE Admin Portal - Frontend Environment Configuration
# ========================================================

# Base URL for API calls made from the frontend.
# - In local dev with Vite proxy: leave as /api
# - In local dev direct connection: http://localhost:5001/api
# - In production: https://your-production-api-domain.com/api
VITE_API_BASE_URL=/api

# Backend server URL for Vite development proxy (used in vite.config.ts)
VITE_BACKEND_URL=http://localhost:5001

# Application branding / metadata
VITE_APP_TITLE="ACE Admin Portal"

